rules_version = '2';

// Firebase 콘솔 > Storage > 규칙 탭에 이 내용을 붙여넣으세요.
// 로그인한 본인의 uid 폴더에만 본인이 파일을 읽고 쓸 수 있도록 제한합니다.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
